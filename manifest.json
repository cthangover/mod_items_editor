{
  "id": "items_editor",
  "name": "Items Editor",
  "version": "0.1.0",
  "author": "ct",
  "description": "Edits a mod's items while the game runs: names and descriptions in every language, price, picture, types and the use action. The game shows a save at once.",
  "categories": ["tools", "editor"],
  "sources": [
    "src/**/*.cs"
  ],
  "depends": [
    "tools_base>=0.1.0",
    "items_base>=0.1.0",
    "ui_base>=0.1.0"
  ],
  "test_suites": [
    {
      "id": "edit",
      "activate": [
        "--itest=items_editor_edit"
      ]
    },
    {
      "id": "foreign_patch",
      "activate": [
        "--itest=editor_foreign_patch"
      ]
    }
  ]
}
